{
  "schemaVersion": 1,
  "id": "scriptables",
  "version": "${version}",
  "name": "Scriptables",
  "description": "A modern CustomNPCs with LuaJ",
  "authors": [
    "TechTastic"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "MIT License",
  "icon": "assets/scriptables/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "io.github.techtastic.scriptables.fabric.ScriptablesFabric",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "io.github.techtastic.scriptables.fabric.client.ScriptablesFabricClient",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "scriptables.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "architectury": ">=13.0.2",
    "fabric-api": "*"
  }
}
